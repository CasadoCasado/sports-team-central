# Dónde está la API de Django.
#
# Déjalo comentado en desarrollo: sin este valor, la app deduce la dirección del
# mismo host desde el que se abrió (puerto 8000). Así funciona igual desde el
# portátil que desde el móvil por la red local, sin tener que poner aquí una IP
# que cambia de una red a otra.
#
# Ponlo solo si la API vive en otro sitio (por ejemplo, ya desplegada):
# VITE_API_URL=https://api.tudominio.com/api
