# Cabeceras de los ficheros estáticos (JS, CSS, imágenes), que Cloudflare
# sirve sin pasar por el Worker. Las de las páginas las pone src/server.ts
# (ver src/lib/cabeceras.ts); estas son las mismas fijas, sin la CSP.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000
