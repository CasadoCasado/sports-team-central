{
  // Nitro genera `.output/server/wrangler.json` en cada compilación y fusiona
  // ESTE fichero dentro (ver `readWranglerConfig` del preset `cloudflare-module`).
  // Sin él, el nombre se deduce del repositorio de GitHub y el Worker sale como
  // `casadocasado-sports-team-central.<sub>.workers.dev`.
  //
  // El nombre decide la URL pública, y esa URL tiene que coincidir **exacta**
  // con `CORS_ALLOWED_ORIGINS` en Render (paso 4 del despliegue).
  //
  // «teamup», sin s, es el Worker de LA DEMO (teamup.<sub>.workers.dev), del
  // nombre de antes de Teamsup. No se cambia mientras la demo siga viva:
  // cambiaría su dirección y los equipos que la usan perderían el enlace. El
  // Worker de producción se llama «teamsup» y se despliega con su nombre en el
  // comando de despliegue (`npx wrangler deploy --name teamsup`, ver la guía de
  // B6). Al apagar la demo, aquí pasa a «teamsup».
  "name": "teamup",
}
